InlayHints:
  Enabled: false
  ParameterNames: false
  DeducedTypes: false

Hover:
  ShowAKA: true

Completion:
  AllScopes: true

Index:
  Background: Skip
  StandardLibrary: true

Diagnostics:
  UnusedIncludes: None

---

If:
  PathMatch: [.*\.c, .*\.h]
CompileFlags:
  Add:
    - -x
    - c
    - -std=c11
    - -Wall
    - -Wextra
    - -Wno-unused-variable
    
---

If:
  PathMatch: [.*\.cpp, .*\.hpp, .*\.cc, .*\.hh, .*\.cxx]
CompileFlags:
  Add:
    - -x
    - c++
    - -std=c++23
    - -Wall
    - -Wextra
    - -I../include
    - -Wno-unused-variable
    - -Wno-unused-includes
